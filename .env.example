# Free Traveler — 환경변수 예시 (TASK-INFRA-VERCEL-DEPLOY)
#
# 실제 값은 이 파일에 채우지 않는다. Vercel Project Settings → Environment
# Variables에 Production/Preview 각각 등록하고, 로컬 개발은 이 파일을 복사한
# `.env.local`(Git 추적 대상 아님)을 사용한다.

# Supabase 프로젝트 URL과 anon key. 둘 다 클라이언트 번들에 포함되는 값이며
# (NEXT_PUBLIC_ 접두사), RLS가 적용된 anon key이므로 노출되어도 안전하다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key는 이 프로젝트에서 아직 서버 전용 코드가 사용하지 않는다
# (CLAUDE.md 규칙 15: Client 코드·클라이언트 번들에 절대 포함 금지). 필요해지면
# NEXT_PUBLIC_ 접두사 없이 서버 전용 환경변수로만 추가하고, Vercel에서도
# "Server-only"로 등록한다. 지금은 값을 채우지 않는다.
# SUPABASE_SERVICE_ROLE_KEY=

# 참고: 항공/숙소 외부 이동 URL(과거 FLIGHT_OUTBOUND_URL/HOTEL_OUTBOUND_URL로
# 검토되었던 값)은 환경변수가 아니라 Supabase `outbound_link_setting` 테이블에
# 저장되며 관리자 화면(SCR-005 `AdminExternalUrlForm`)에서 수정한다
# (API-ADMIN-OUTBOUND-SETTINGS, CLAUDE.md 규칙 13). 이 값을 위한 환경변수는
# 만들지 않는다.
